<Window x:Class="X4ModLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="X4 Mod Launcher" SizeToContent="WidthAndHeight" MinWidth="920" MinHeight="650"
        WindowStyle="None" ResizeMode="NoResize"
        Background="{StaticResource PageBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <Style TargetType="ListViewItem">
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource ButtonHoverBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid Margin="22" PreviewMouseLeftButtonDown="WindowDrag">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock Text="X4 Mod Launcher" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
        <TextBlock Text="Safe, inspectable extension profiles for X4: Foundations" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,4,0,0" />
        <TextBlock Text="Safety: this changes extension availability only. Do not load or save a modded save while required extensions are disabled; save continuity can break." Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
        <TextBlock Text="Made by: Alakeram" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,0" />
      </StackPanel>
      <Button Grid.Column="1" Content="Close" Width="76" Height="32" Click="Close_Click" VerticalAlignment="Top" ToolTip="Close the launcher" />
    </Grid>

    <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="155" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="90" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="X4 install" VerticalAlignment="Center" />
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="X4RootBox" ToolTip="Folder containing X4.exe" />
        <Button Grid.Row="0" Grid.Column="2" Content="Auto-find" Click="AutoFind_Click" />
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Profile content.xml" VerticalAlignment="Center" />
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="ProfilePathBox" ToolTip="The profile XML to edit; never a save file" />
        <Button Grid.Row="1" Grid.Column="2" Content="Browse" Click="BrowseProfile_Click" />
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Backup folder" VerticalAlignment="Center" />
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="BackupDirectoryBox" ToolTip="Backups are timestamped and never overwrite an existing backup" />
        <Button Grid.Row="2" Grid.Column="2" Content="Browse" Click="BrowseBackup_Click" />
      </Grid>
    </Border>

    <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,12">
      <DockPanel LastChildFill="False">
        <TextBlock Text="Mod Profiles" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
        <ComboBox x:Name="ProfileSelector" ItemsSource="{Binding ProfileNames}" SelectionChanged="ProfileSelector_SelectionChanged" DropDownOpened="ProfileSelector_DropDownOpened" DropDownClosed="ProfileSelector_DropDownClosed" Width="220" Height="30" VerticalContentAlignment="Center" ToolTip="Choose a saved mod profile or create a new one" />
        <Button Content="Save Current" Click="SaveProfile_Click" Width="105" HorizontalContentAlignment="Center" />
        <Button Content="Load" Click="LoadProfile_Click" Width="105" HorizontalContentAlignment="Center" />
        <Button Content="Load &amp; Launch" Click="LoadLaunchProfile_Click" Width="125" HorizontalContentAlignment="Center" />
        <Button Content="Delete" Click="DeleteProfile_Click" Width="105" HorizontalContentAlignment="Center" />
      </DockPanel>
    </Border>

    <DockPanel Grid.Row="3" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
        <Button Content="Refresh" Click="Refresh_Click" />
        <Button Content="Select Backup" Click="Restore_Click" />
        <Button Content="Remove deprecated entries" Click="RemoveDeprecated_Click" ToolTip="Remove stale profile records for extensions whose folders are no longer installed" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
        <Button Content="Apply" Click="Apply_Click" />
        <Button Content="Apply &amp; Launch" Click="ApplyLaunch_Click" />
        <Button Content="Launch Game" Click="LaunchGame_Click" />
      </StackPanel>
    </DockPanel>

    <Border Grid.Row="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" x:Name="CatalogHint" Text="Installed extensions are listed here. Unchecked items are installed but disabled in the selected profile; DLC is read-only." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="8,2,8,8" />
        <Grid Grid.Row="1" Margin="8,2,8,6">
          <Grid.ColumnDefinitions>
          <ColumnDefinition Width="76" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="90" />
          <ColumnDefinition Width="115" />
          <ColumnDefinition Width="115" />
          <ColumnDefinition Width="275" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Use" Foreground="{StaticResource MutedBrush}" />
          <TextBlock Grid.Column="1" Text="Extension" Foreground="{StaticResource MutedBrush}" />
          <TextBlock Grid.Column="2" Text="Version" Foreground="{StaticResource MutedBrush}" />
          <TextBlock Grid.Column="3" Text="Current" Foreground="{StaticResource MutedBrush}" />
          <TextBlock Grid.Column="4" Text="Desired" Foreground="{StaticResource MutedBrush}" />
          <TextBlock Grid.Column="5" Text="Safety / dependency status" Foreground="{StaticResource MutedBrush}" />
        </Grid>
        <ListView Grid.Row="2" x:Name="ExtensionList" ItemsSource="{Binding Rows}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListView.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,2" PreviewMouseLeftButtonUp="ExtensionRow_Click">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="76" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="90" />
                  <ColumnDefinition Width="115" />
                  <ColumnDefinition Width="115" />
                  <ColumnDefinition Width="275" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="{Binding UseLabel}" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" IsEnabled="{Binding UseEnabled}" Width="68" Height="28" Margin="0" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="ExtensionToggle_Click" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Id}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding VersionLabel}" TextTrimming="CharacterEllipsis" ToolTip="{Binding VersionLabel}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding CurrentLabel}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="{Binding DesiredLabel}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="5" Text="{Binding StatusLabel}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusLabel}" VerticalAlignment="Center" Foreground="{Binding StatusBrush}" />
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </Grid>
    </Border>

    <DockPanel Grid.Row="5" Margin="0,12,0,0">
      <TextBlock x:Name="StatusText" Text="Ready. X4 is not touched until you press Apply." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
      <TextBlock DockPanel.Dock="Right" Text="DLC is read-only • saves are never edited" Foreground="{StaticResource WarningBrush}" Margin="20,0,0,0" />
    </DockPanel>
  </Grid>
</Window>
