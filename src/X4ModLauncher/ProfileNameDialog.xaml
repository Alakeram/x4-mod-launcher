<Window x:Class="X4ModLauncher.ProfileNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Mod Profile" Width="430" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" Foreground="{StaticResource TextBrush}">
  <Border Background="{StaticResource PanelBrush2}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Padding="1">
    <Grid PreviewMouseLeftButtonDown="WindowDrag">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
        <Grid>
          <TextBlock Text="Create Mod Profile" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="×" Width="30" Height="26" Padding="0" Margin="0" HorizontalAlignment="Right" Click="Cancel_Click" ToolTip="Close" />
        </Grid>
      </Border>

      <StackPanel Grid.Row="1" Margin="18,16,18,0">
        <TextBlock Text="Give the current extension selection a name." Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10" />
        <TextBox x:Name="NameBox" MinWidth="360" ToolTip="Profile name" />
      </StackPanel>

      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,14,18,16">
        <Button Content="Save" Width="100" Click="Save_Click" HorizontalContentAlignment="Center" />
        <Button Content="Cancel" Width="100" Click="Cancel_Click" HorizontalContentAlignment="Center" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
