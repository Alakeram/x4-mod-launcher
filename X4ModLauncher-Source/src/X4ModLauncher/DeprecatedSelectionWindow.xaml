<Window x:Class="X4ModLauncher.DeprecatedSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remove Deprecated Entries" Width="680" Height="520" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" Foreground="{StaticResource TextBrush}">
  <Border Background="{StaticResource PanelBrush2}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Padding="1">
  <Grid PreviewMouseLeftButtonDown="WindowDrag" Margin="0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
      <Grid>
        <TextBlock Text="Remove Deprecated Entries" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="×" Width="30" Height="26" Padding="0" Margin="0" HorizontalAlignment="Right" Click="Cancel_Click" ToolTip="Close" />
      </Grid>
    </Border>

    <TextBlock Grid.Row="1" Text="These entries are stale records in content.xml; their extension folders are already missing. Choose ALL or SELECT, then confirm the backup step." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="18,14,18,12" />
    <ListBox Grid.Row="2" ItemsSource="{Binding Choices}" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="6" Margin="18,0,18,0">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Padding="4" Margin="2">
            <StackPanel>
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Id}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
            </StackPanel>
          </CheckBox>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,14,18,16">
      <Button Content="Remove ALL" Width="125" Click="RemoveAll_Click" HorizontalContentAlignment="Center" />
      <Button Content="Remove SELECTED" Width="145" Click="RemoveSelected_Click" HorizontalContentAlignment="Center" />
      <Button Content="Cancel" Width="100" Click="Cancel_Click" HorizontalContentAlignment="Center" />
    </StackPanel>
  </Grid>
  </Border>
</Window>
